# ====================================================
# SRI SHANMUKHA COMPUTER INSTITUTE (SSCI) - ENV TEMPLATE
# ====================================================

# DATABASE (MongoDB Atlas Production Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ssci?retryWrites=true&w=majority

# BACKEND SECURITY & JWT SECRET
JWT_SECRET=your_super_secret_jwt_random_key_min_32_chars

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=production

# CORS ORIGIN CONFIGURATION (ALLOWED FRONTEND DOMAINS)
FRONTEND_URL=https://sscomputerinstitute.com
BACKEND_URL=https://sscomputer-api.onrender.com

# FRONTEND CLIENT API ENDPOINT (Used during Vercel Build)
VITE_API_URL=https://sscomputer-api.onrender.com

# ====================================================
# TRANSACTIONAL EMAIL NOTIFICATIONS (BACKEND ONLY)
# ====================================================
# When a lead submits an enquiry:
# 1. An internal notification is sent to the consultancy team.
# 2. A brief confirmation is sent to the candidate's email (if provided).
# Never expose these credentials in frontend code or VITE_ variables.

# Team Recipient (Comma-separated for multiple recipients)
CONSULTANCY_TEAM_EMAIL=sscomputerinstitutenlr@gmail.com, ugssolutions1@gmail.com

# From Header (Sender name & address)
EMAIL_FROM="Sri Shanmukha Computer Institute" <sscomputerinstitutenlr@gmail.com>

# --- OPTION A: SMTP Provider (SendGrid, AWS SES, Mailgun, Brevo, Gmail SMTP, etc.) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_password_here

# --- OPTION B: Resend API Alternative ---
# RESEND_API_KEY=re_123456789abcdef

